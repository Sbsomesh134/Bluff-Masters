-- Ensure pgcrypto exists, then add its actual schema to the SECURITY DEFINER
-- function's search_path. Existing installations are not moved between schemas.
create schema if not exists extensions;
create extension if not exists pgcrypto with schema extensions;

do $migration$
declare
  v_crypto_schema text;
begin
  select n.nspname
    into v_crypto_schema
    from pg_extension e
    join pg_namespace n on n.oid=e.extnamespace
   where e.extname='pgcrypto';

  if v_crypto_schema is null then
    raise exception 'pgcrypto is not installed; room-code generation cannot be repaired';
  end if;

  execute format(
    'alter function public.game_action(uuid,text,text,jsonb) set search_path to %L',
    format('pg_catalog, %I, public, pg_temp', v_crypto_schema)
  );
end
$migration$;

