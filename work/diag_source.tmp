-- Read-only checks for the pgcrypto room-code failure.
select e.extname, e.extversion, n.nspname as extension_schema
from pg_extension e
join pg_namespace n on n.oid=e.extnamespace
where e.extname='pgcrypto';

select
  p.oid::regprocedure as function_name,
  pg_get_userbyid(p.proowner) as owner,
  p.prosecdef as security_definer,
  p.proconfig as function_settings,
  regexp_match(pg_get_functiondef(p.oid), E'[^\\n]*gen_random_bytes[^\\n]*') as room_code_call
from pg_proc p
where p.oid='public.game_action(uuid,text,text,jsonb)'::regprocedure;

select
  current_setting('search_path') as session_search_path,
  to_regprocedure('gen_random_bytes(integer)')::text as visible_unqualified_function,
  to_regprocedure('extensions.gen_random_bytes(integer)')::text as extensions_schema_function,
  to_regprocedure('public.gen_random_bytes(integer)')::text as public_schema_function;

